{
  "name": "@vcser/desktop",
  "version": "0.1.1-beta.1",
  "private": true,
  "description": "Desktop app to sync extensions and settings across VS Code-based editors",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/Orchardxyz/vcser/tree/main/apps/desktop",
  "bugs": {
    "url": "https://github.com/Orchardxyz/vcser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orchardxyz/vcser.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/rebuild-native-modules.cjs",
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "package:dir": "node scripts/sync-runtime-assets.cjs && electron-builder --dir",
    "package:mac": "node scripts/sync-runtime-assets.cjs && electron-builder --mac --publish never",
    "package:win": "node scripts/sync-runtime-assets.cjs && electron-builder --win --publish never",
    "package:linux": "node scripts/sync-runtime-assets.cjs && electron-builder --linux --publish never",
    "preview": "electron-vite preview",
    "icons:generate": "bash ../../scripts/generate-icons.sh",
    "postinstall": "node scripts/ensure-electron-binary.cjs && node scripts/rebuild-native-modules.cjs"
  },
  "build": {
    "appId": "com.vcser.app",
    "productName": "vcser",
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/icon-macos-1024.png",
        "to": "icon-macos-1024.png"
      },
      {
        "from": "resources/runtime/core/prisma/migrations",
        "to": "core/prisma/migrations"
      },
      {
        "from": "resources/runtime/core/generated/prisma",
        "to": "core/generated/prisma"
      }
    ],
    "mac": {
      "icon": "resources/icons/mac/icon.icns"
    },
    "win": {
      "icon": "resources/icons/win/icon.ico"
    },
    "linux": {
      "icon": "resources/icons/png/512x512.png",
      "maintainer": "Orchard <orchard@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "catalog:prisma7",
    "@prisma/client": "catalog:prisma7",
    "@prisma/client-runtime-utils": "catalog:prisma7",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "classnames": "^2.5.1",
    "i18next": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "catalog:react18",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "catalog:react18",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.7",
    "react-router-dom": "6.30.1",
    "react-use": "^17.6.0",
    "sonner": "^2.0.7",
    "type-fest": "catalog:shared-runtime",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "@vcser/core": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "catalog:electron33",
    "electron-builder": "catalog:electron33",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "catalog:electron33",
    "tailwindcss": "^4.1.0",
    "vite": "^5.4.11"
  }
}
