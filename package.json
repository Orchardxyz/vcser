{
  "name": "vcser",
  "version": "0.1.0",
  "description": "Workspace for vcser desktop app and reusable runtime core",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "changeset": "changeset",
    "dev": "pnpm core:build && pnpm --filter @vcser/desktop dev",
    "build": "pnpm core:build && pnpm --filter @vcser/desktop build",
    "preview": "pnpm --filter @vcser/desktop preview",
    "package:dir": "pnpm build && pnpm --filter @vcser/desktop package:dir",
    "package:mac": "pnpm build && pnpm --filter @vcser/desktop package:mac",
    "package:win": "pnpm build && pnpm --filter @vcser/desktop package:win",
    "package:linux": "pnpm build && pnpm --filter @vcser/desktop package:linux",
    "cli:build": "pnpm core:build && pnpm --filter @vcser/cli build",
    "cli:dev": "pnpm --filter @vcser/cli dev",
    "cli:smoke": "pnpm --filter @vcser/cli smoke",
    "cli:watch": "pnpm --filter @vcser/cli build:watch",
    "cli:start": "pnpm --filter @vcser/cli start",
    "cli:typecheck": "pnpm core:build && pnpm --filter @vcser/cli typecheck",
    "core:build": "pnpm --filter @vcser/core build",
    "icons:generate": "bash scripts/generate-icons.sh",
    "db:generate": "pnpm --filter @vcser/core db:generate",
    "db:migrate": "pnpm --filter @vcser/core db:migrate",
    "db:studio": "npx prisma studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "release:pack:core": "pnpm --filter @vcser/core pack --dry-run",
    "release:pack:cli": "pnpm --filter @vcser/cli pack --dry-run",
    "release:plan": "node ./scripts/release/preview-release.mjs",
    "release:resolve": "node ./scripts/release/resolve-release.mjs",
    "release:prerelease:enter": "node ./scripts/release/enter-prerelease.mjs",
    "release:prerelease:exit": "changeset pre exit",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "test": "vitest run",
    "test:core": "vitest run packages/core/test",
    "test:cli": "vitest run packages/cli/test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "vscode",
    "cursor",
    "windsurf",
    "kiro",
    "extensions",
    "sync",
    "desktop",
    "electron"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/changelog-git": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@eslint/js": "catalog:linting",
    "@types/node": "catalog:typescript",
    "electron": "catalog:electron33",
    "eslint": "catalog:linting",
    "eslint-config-prettier": "catalog:linting",
    "eslint-plugin-pnpm": "catalog:linting",
    "eslint-plugin-react-hooks": "catalog:linting",
    "eslint-plugin-react-refresh": "catalog:linting",
    "globals": "catalog:linting",
    "husky": "catalog:other",
    "jsonc-eslint-parser": "catalog:linting",
    "lint-staged": "catalog:other",
    "prettier": "catalog:other",
    "prisma": "catalog:prisma7",
    "typescript": "catalog:typescript",
    "typescript-eslint": "catalog:linting",
    "vitest": "catalog:testing",
    "yaml-eslint-parser": "catalog:linting"
  }
}
