{
  "name": "@vcser/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app to sync extensions and settings across VS Code-based editors",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "icons:generate": "bash scripts/generate-icons.sh",
    "postinstall": "node scripts/ensure-electron-binary.cjs"
  },
  "build": {
    "appId": "com.vcser.app",
    "productName": "vcser",
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/icon-macos-1024.png",
        "to": "icon-macos-1024.png"
      }
    ],
    "mac": {
      "icon": "resources/icons/mac/icon.icns"
    },
    "win": {
      "icon": "resources/icons/win/icon.ico"
    },
    "linux": {
      "icon": "resources/icons/png/512x512.png"
    }
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "classnames": "^2.5.1",
    "i18next": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "6.30.1",
    "react-use": "^17.6.0",
    "sonner": "^2.0.7",
    "type-fest": "^5.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vcser/core": "workspace:*",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^5.4.11"
  }
}
