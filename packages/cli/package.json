{
  "name": "@vcser/cli",
  "version": "0.1.0",
  "description": "CLI to sync local extensions across VS Code-based editors",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/Orchardxyz/vcser/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/Orchardxyz/vcser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orchardxyz/vcser.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "vscer": "./dist/bin.cjs"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:watch": "node ./scripts/build.mjs --watch",
    "dev": "node ./scripts/build.mjs --watch",
    "smoke": "pnpm run build && node ./dist/bin.cjs --help",
    "start": "node ./dist/bin.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vcser/core": "workspace:*",
    "cac": "^6.7.14",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.24.2"
  }
}
