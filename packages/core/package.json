{
  "name": "@vcser/core",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable runtime core for vcser editor detection, sync, and persistence",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/Orchardxyz/vcser/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/Orchardxyz/vcser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orchardxyz/vcser.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": "./src/index.ts",
    "./customEditors": "./src/customEditors.ts",
    "./db": "./src/db.ts",
    "./editors/detect": "./src/editors/detect/index.ts",
    "./editors/detect/detect": "./src/editors/detect/detect.ts",
    "./editors/extensions": "./src/editors/extensions/index.ts",
    "./editors/extensions/extensions": "./src/editors/extensions/extensions.ts",
    "./editors/extensions/extensionSync": "./src/editors/extensions/extensionSync.ts",
    "./editors/*": "./src/editors/*.ts",
    "./generated/prisma": "./src/generated/prisma/index.js",
    "./i18n": "./src/shared/i18n.ts",
    "./ipc": "./src/shared/ipc.ts",
    "./package.json": "./package.json",
    "./typeGuards": "./src/typeGuards.ts",
    "./types": "./src/shared/types.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --config ../../prisma.config.ts --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --config ../../prisma.config.ts --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate --config ../../prisma.config.ts --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "catalog:prisma7",
    "@prisma/client": "catalog:prisma7",
    "@prisma/client-runtime-utils": "catalog:prisma7",
    "jsonc-parser": "^3.3.1",
    "type-fest": "catalog:shared-runtime"
  },
  "devDependencies": {
    "prisma": "catalog:prisma7"
  }
}
