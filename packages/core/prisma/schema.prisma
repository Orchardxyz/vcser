generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ExtensionNamespaceCache {
  id          Int    @id @default(autoincrement())
  extensionId String
  namespace   String

  @@unique([extensionId, namespace])
  @@index([namespace])
}
