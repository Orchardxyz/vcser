{
  "name": "@vcser/cli",
  "version": "1.1.1",
  "description": "CLI to sync local extensions across Visual Studio Code-based editors",
  "keywords": [
    "vcser",
    "cli",
    "vscode",
    "extensions",
    "settings-sync"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://vcser.oryz.work/",
  "bugs": {
    "url": "https://github.com/Orchardxyz/vcser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orchardxyz/vcser.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/bin.cjs",
    "dist/bin.cjs.map"
  ],
  "bin": {
    "vcser": "./dist/bin.cjs"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:watch": "node ./scripts/build.mjs --watch",
    "dev": "node ./scripts/build.mjs --watch",
    "prepack": "pnpm --filter @vcser/core build && pnpm run build",
    "smoke": "pnpm run build && node ./dist/bin.cjs --help",
    "start": "node ./dist/bin.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vcser/core": "workspace:*",
    "cac": "catalog:cli-tooling",
    "ora": "catalog:cli-tooling",
    "picocolors": "catalog:cli-tooling",
    "prompts": "catalog:cli-tooling"
  },
  "devDependencies": {
    "@types/prompts": "catalog:cli-tooling",
    "esbuild": "catalog:cli-tooling"
  }
}
