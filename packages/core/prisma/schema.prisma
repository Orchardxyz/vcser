generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ExtensionNamespaceCache {
  id          Int    @id @default(autoincrement())
  extensionId String
  namespace   String

  @@unique([extensionId, namespace])
  @@index([namespace])
}

model CustomEditor {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  displayName    String
  cli            String?
  appPath        String?
  extensionsPath String
  settingsPath   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
}
