{
  "name": "vcser",
  "version": "0.1.0",
  "description": "Desktop app to sync extensions and settings across VS Code-based editors",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "icons:generate": "bash scripts/generate-icons.sh",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.vcser.app",
    "productName": "vcser",
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/icon-macos-1024.png",
        "to": "icon-macos-1024.png"
      }
    ],
    "mac": {
      "icon": "resources/icons/mac/icon.icns"
    },
    "win": {
      "icon": "resources/icons/win/icon.ico"
    },
    "linux": {
      "icon": "resources/icons/png/512x512.png"
    }
  },
  "keywords": [
    "vscode",
    "cursor",
    "windsurf",
    "kiro",
    "extensions",
    "sync",
    "desktop",
    "electron"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "classnames": "^2.5.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.0",
    "sonner": "^2.0.7",
    "type-fest": "^5.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.4.11"
  }
}
